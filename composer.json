{
    "name": "olegabr/web3.php",
    "description": "Ethereum web3 interface.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "sc0Vu",
            "email": "alk03073135@gmail.com"
        },
        {
            "name": "Oleg Abrosimov",
            "email": "olegabrosimovnsk@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/olegabr/rlp"
        },
        {
            "type": "vcs",
            "url": "https://github.com/olegabr/ethereum-util"
        },
        {
            "type": "vcs",
            "url": "https://github.com/olegabr/ethereum-tx"
        },
        {
            "type": "vcs",
            "url": "https://github.com/olegabr/php-keccak"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^7.0",
        "php": ">=8.1",
        "olegabr/keccak": "~1.0",
        "phpseclib/phpseclib": "^3.0.1",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ratchet/pawl": "^0.4.1 - only for Web3\\Providers\\WsProvider, i.e. the ws:// and wss:// transport; pulls in react/*",
        "react/async": "^4.0.0|^3.1.0 - same reason, installed by ratchet/pawl",
        "react/promise-timer": "^1.10 - same reason, needed for the connection timeout"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "ratchet/pawl": "^0.4.1",
        "react/http": "^1.6.0",
        "react/async": "^4.0.0|^3.1.0",
        "react/promise": "^2.9.0",
        "react/event-loop": "^1.2",
        "react/socket": "^1.13",
        "react/promise-timer": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Web3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test/"
        }
    }
}
